      "Bash(node tools/wo-gate.mjs --start:*)",
      "Bash(node tools/wo-gate.mjs --release:*)",
      "PowerShell(node tools/wo-gate.mjs --tick:*)",
      "PowerShell(node tools/wo-gate.mjs --start:*)",
      "PowerShell(node tools/wo-gate.mjs --release:*)"
    ]
  }
